# ---------------------------------------------------------------------------
# ThreatLens configuration.
# Copy this file to ".env" in the project root and edit the values.
# Never commit the real .env file. The defaults below are development-only.
# ---------------------------------------------------------------------------

# --- Flask / API -----------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Generate strong values for any non-local use, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
# Access token lifetime in seconds (default: one hour).
JWT_ACCESS_TOKEN_EXPIRES=3600

# Comma-separated browser origins allowed to call the API.
# Local: http://localhost:5173,http://127.0.0.1:5173
# Deployed: add the exact Vercel origin, e.g. https://threatlens.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# Defaults to backend/instance/threatlens.db when unset.
# DATABASE_URL=sqlite:///C:/absolute/path/to/threatlens.db
#
# Hosted deployments MUST use PostgreSQL: Render's filesystem is ephemeral and
# a SQLite file is deleted on every deploy/spin-down. Example (Neon):
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# STORAGE_DIR=C:/absolute/path/to/backend/storage
AUTO_INIT_DB=true

# --- Limits ----------------------------------------------------------------
MAX_CONTENT_LENGTH=6291456
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=25000000
MAX_TEXT_CHARS=20000
HTTP_CONNECT_TIMEOUT=4.0
HTTP_READ_TIMEOUT=8.0
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=2097152
DNS_TIMEOUT=5.0
MAX_EXTRACTED_URLS_EMAIL=3
MAX_EXTRACTED_URLS_IMAGE=3

# --- Rate limits (requests per 60-second window, in-process) ---------------
RATE_LIMIT_AUTH=10
RATE_LIMIT_SCAN=20
RATE_LIMIT_COMMUNITY=20
RATE_LIMIT_COMPLAINT=10
REPORTS_TO_FLAG=3

# --- Optional capabilities (disabled by default) ---------------------------
# Isolated Playwright browser rendering. Requires "playwright" and a Chromium
# install. Leave disabled unless you need JavaScript-rendered page evidence.
ENABLE_BROWSER_SCAN=false
BROWSER_TIMEOUT_MS=15000
BROWSER_SETTLE_MS=1500

# OCR for screenshots. Requires "easyocr"; model weights download on first use.
ENABLE_OCR=false

# External reputation has no provider wired up in this build. Enabling this
# flag does not add one; it only advertises intent.
ENABLE_EXTERNAL_REPUTATION=false

# Optional local model artifacts produced by the scripts in /ml.
# URL_MODEL_PATH=C:/absolute/path/to/ml/models/url_model.joblib
# EMAIL_MODEL_PATH=C:/absolute/path/to/ml/models/email_model.joblib
# SMS_MODEL_PATH=C:/absolute/path/to/ml/models/sms_model.joblib
# Body-only messages at or below this length use the 3-class SMS model.
SMS_MAX_CHARS=700

# --- DANGEROUS: tests only -------------------------------------------------
# Permits scanning loopback/private addresses. NEVER enable on a shared or
# internet-facing instance; it defeats the SSRF protections.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# ---------------------------------------------------------------------------
# Frontend (place in frontend/.env.local, not here)
# By default Vite proxies /api to http://127.0.0.1:5000, so this can stay unset.
# VITE_API_BASE=
# ---------------------------------------------------------------------------
