# Frontend environment for Vercel (and local production builds).
#
# Vite bakes this value into the bundle at BUILD time. After changing it you
# must redeploy the Vercel project; editing it while the site is running has no
# effect.
#
# Local development keeps this unset: vite.config.js proxies /api to
# http://127.0.0.1:5000.
#
# Production: paste the public Render URL of the API, with NO trailing slash.
VITE_API_BASE=https://your-service-name.onrender.com
